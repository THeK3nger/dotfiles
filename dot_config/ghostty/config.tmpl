# Shared config and shader sources live under dot_config/ghostty.
# The macOS templates include them; .chezmoiignore selects the native directory:
# ~/Library/Application Support/com.mitchellh.ghostty on macOS, ~/.config/ghostty on Linux.
font-family = "JetBrains Mono"
font-size = 14

theme = "Catppuccin Mocha"

cursor-style = block
cursor-color = "#818CF8"

copy-on-select = clipboard

{{ if eq .chezmoi.os "darwin" -}}
macos-option-as-alt = true
macos-titlebar-style = tabs
{{ else if eq .chezmoi.os "linux" -}}
window-decoration = client
{{ end }}
keybind = alt+left=unbind
keybind = alt+right=unbind

custom-shader = "./shaders/cursor_smear.glsl"
keybind = shift+enter=text:\n
